{
  "name": "@altern-digital/metro-ui",
  "version": "0.1.0",
  "description": "A very light Metro (Windows 8/10) UI library for React: flat tiles, one accent, adaptive mobile and desktop components, themed through a ConfigProvider.",
  "license": "MIT",
  "author": "Altern Digital",
  "homepage": "https://altern-digital.github.io/metro-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altern-digital/metro-ui.git"
  },
  "bugs": {
    "url": "https://github.com/altern-digital/metro-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite playground",
    "build": "tsdown && bun run scripts/build-css.ts",
    "build:playground": "vite build playground",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src playground/src",
    "test": "bun test",
    "size": "size-limit",
    "check": "bun run typecheck && bun run lint && bun test && bun run build && bun run size"
  },
  "peerDependencies": {
    "motion": ">=12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@mantine/hooks": "^9.7.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "easing-utils": "^1.0.0",
    "happy-dom": "^20.14.5",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.87.0",
    "react-icons": "^5.7.0",
    "size-limit": "^14.1.0",
    "sucrase": "^3.35.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "react",
    "ui",
    "metro",
    "windows",
    "fluent",
    "components",
    "tiles"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
